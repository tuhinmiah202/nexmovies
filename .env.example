# ============================================
# MovieBox Environment Variables
# ============================================
# Copy this file to .env and fill in your real values.
# NEVER commit the actual .env file — it is listed in .gitignore.
#
# Set these same values in your Vercel Project →
# Settings → Environment Variables for production.

# Backend Moviebox-API URL (your Vercel backend deploy)
# Example: API_URL=https://your-backend.vercel.app
API_URL=

# TMDB API key (get one free at https://developers.themoviedb.org)
TMDB_API_KEY=

# Server port (default 7860, only used when running locally)
PORT=7860